{
  "name": "@hashrate-autopilot/daemon",
  "version": "0.1.0",
  "description": "Control loop, HTTP API, and state store for the Hashrate Autopilot",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force && mkdir -p dist/state dist/data && cp -R src/state/migrations dist/state/ && cp src/data/pools-v2.json dist/data/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/compress": "^9.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@hashrate-autopilot/bitcoind-client": "*",
    "@hashrate-autopilot/braiins-client": "*",
    "@hashrate-autopilot/shared": "*",
    "@inquirer/prompts": "^8.5.2",
    "bech32": "^2.0.0",
    "better-sqlite3": "~12.11.1",
    "fastify": "^5.12.0",
    "kysely": "^0.29.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
